+/* phv_pre (lane badoptions): until a game first shows a normal frame (in_normal_game) no hero exists, and a state digest would
+   read youmonst.data (ACURR): the digest line, every bound observation buffer hashed raw (internal 9 ints with [6] zeroed,
+   misc 3 ints, as the digest), no sections */
+static void pre_obs(uint64_t *v, const void *const *ob)
+{
+    static const size_t sz[PHD_NOBS] = PHD_OBS_SIZES;
+    for (int k = 0; k < PHD_NSEC; k++)
+        v[PHD_SEC0 + k] = 0;
+    for (int j = 0; j < PHD_NOBS; j++) {
+        if (!ob[j]) {
+            v[PHD_OBS0 + j] = PHD_UNBOUND;
+            continue;
+        }
+        unsigned char buf[55 * 80];
+        memcpy(buf, ob[j], sz[j]);
+        if (j == 7)
+            memset(buf + 6 * 4, 0, 4);
+        uint64_t h = 0xcbf29ce484222325ULL;
+        for (size_t i = 0; i < sz[j]; i++)
+            h = (h ^ buf[i]) * 0x100000001b3ULL;
+        v[PHD_OBS0 + j] = h ^ 0x7072656f6273ULL;
+    }
+}
 static uint64_t keycomp(int i, int key)
 {
     return (uint64_t) (uint32_t) i << 32 | (uint32_t) key;
